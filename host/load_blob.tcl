# =====================================================================
#  Заливка запакованого ролика у SDRAM плати DE1-SoC
# ---------------------------------------------------------------------
#  Запуск:
#      quartus_stp -t load_blob.tcl video.bin
#
#  Скрипт виконується в середовищі System Console, яке входить до
#  складу Quartus. Він відкриває ведучий пристрій мосту JTAG-to-Avalon,
#  реалізованого в самій системі, і пише файл прямо в SDRAM.
# ---------------------------------------------------------------------
#  ЧОМУ САМЕ ТАК, А НЕ ЧЕРЕЗ MONITOR PROGRAM
#
#  Monitor Program завантажує програму у форматі SREC - це текстовий
#  формат, у якому кожен байт записано двома шістнадцятковими цифрами.
#  Ролик на двадцять шість мегабайтів перетворився б на п'ятдесят із
#  гаком мегабайтів тексту, і заливка тривала б непристойно довго,
#  якщо взагалі завершилася б. Тому програма й дані заливаються
#  окремо: програма - через Monitor Program, ролик - цим скриптом,
#  двійковим файлом як є.
# ---------------------------------------------------------------------
#  ПРО АДРЕСУ
#
#  Ведучий пристрій мосту бачить SDRAM за адресою 0x00000000, тоді як
#  ядро ARM ту саму пам'ять бачить за 0xC0000000 - це різні вікна в
#  ту саму мікросхему. Тому тут адреса 0x00100000, а програвач читає
#  ролик за 0xC0100000. Значення перевірено за картою адрес системи,
#  а не взято з голови.
#
#  Перший мегабайт SDRAM лишається під два буфери зображення:
#      0x000000  передній буфер   245 760 байтів
#      0x040000  задній буфер     245 760 байтів
#      0x100000  ролик
# ---------------------------------------------------------------------
#  ПРО ПОРЯДОК ЗАПИСУ
#
#  Підпис "DE1V" лежить на початку блока, тобто приїздить першим -
#  коли решти даних ще немає. Якби програвач чекав тільки його, показ
#  почався б із порожнечі. Тому пакувальник дублює підпис в останніх
#  чотирьох байтах, а цей скрипт перед заливкою обнуляє і початок, і
#  кінець, і лише після успішного перенесення ставить кінцевий підпис
#  на місце власноруч. Тоді порядок, у якому пише ведучий пристрій,
#  узагалі перестає мати значення.
# =====================================================================

set BLOB_ADDR 0x00100000

# --------------------------------------------------------------- вхід
if { $argc < 1 } {
    puts "Використання: quartus_stp -t load_blob.tcl <файл.bin> \[адреса\]"
    exit 1
}
set blob_file [lindex $argv 0]
if { $argc >= 2 } {
    set BLOB_ADDR [lindex $argv 1]
}
if { ![file exists $blob_file] } {
    puts "Немає файлу: $blob_file"
    exit 1
}
set blob_size [file size $blob_file]
set tail_addr [expr {$BLOB_ADDR + $blob_size - 4}]

puts "файл:   $blob_file"
puts "розмір: $blob_size байтів ([format %.2f [expr {$blob_size / 1048576.0}]] МіБ)"
puts "адреса: $BLOB_ADDR (ведучий пристрій мосту; ядро побачить за 0xC0100000)"
puts ""

# ----------------------------------------------- пошук ведучого пристрою
set masters [get_service_paths master]
if { [llength $masters] == 0 } {
    puts "Ведучих пристроїв не знайдено."
    puts "Перевірте: плата увімкнена, кабель у роз'ємі USB Blaster,"
    puts "ПЛІС прошито файлом DE1_SoC_Computer.sof."
    exit 1
}

puts "знайдено ведучих пристроїв: [llength $masters]"
foreach m $masters { puts "   $m" }
puts ""

# Потрібен саме той міст, що дістає SDRAM. У системі їх два:
# JTAG_to_FPGA_Bridge бачить SDRAM, JTAG_to_HPS_Bridge - ні.
set target ""
foreach m $masters {
    if { [string match "*JTAG_to_FPGA*" $m] } {
        set target $m
        break
    }
}
if { $target eq "" } {
    set target [lindex $masters 0]
    puts "Міст JTAG_to_FPGA за іменем не знайдено, беремо перший зі списку."
    puts "Якщо заливка не вдасться, вкажіть потрібний шлях вручну."
}
puts "використовуємо: $target"
puts ""

# ---------------------------------------------------------- заливка
open_service master $target

# Перевірка зв'язку: пишемо й читаємо контрольне слово.
master_write_32 $target $BLOB_ADDR 0xA5A5F00D
set back [master_read_32 $target $BLOB_ADDR 1]
if { [format 0x%08X [lindex $back 0]] ne "0xA5A5F00D" } {
    puts "Пам'ять не відповідає: записали 0xA5A5F00D, прочитали [lindex $back 0]."
    puts "Найімовірніше, прошито не ту конфігурацію або адреса хибна."
    close_service master $target
    exit 1
}

# Обидва підписи геть, щоб програвач не почав показ із півдороги.
master_write_32 $target $BLOB_ADDR 0x00000000
master_write_32 $target $tail_addr  0x00000000
puts "зв'язок із SDRAM є, підписи знято, починаємо заливку"
puts ""

set t0 [clock milliseconds]
master_write_from_file $target $blob_file $BLOB_ADDR
set t1 [clock milliseconds]
set secs [expr {($t1 - $t0) / 1000.0}]

# ------------------------------------------------------- перевірка
# Початковий підпис має приїхати разом із файлом; кінцевий ставимо
# власноруч, бо саме він для програвача означає «дані на місці».
set head [master_read_32 $target $BLOB_ADDR 1]
set got [format 0x%08X [lindex $head 0]]
if { $got eq "0x56314544" } {
    master_write_32 $target $tail_addr 0x56314544
}
set tail [master_read_32 $target $tail_addr 1]
set got_tail [format 0x%08X [lindex $tail 0]]
close_service master $target

puts ""
puts "залито за [format %.1f $secs] с ([format %.2f [expr {$blob_size / 1048576.0 / ($secs + 0.001)}]] МіБ/с)"
puts "підпис на початку: $got (має бути 0x56314544, тобто \"DE1V\")"
puts "підпис у кінці:    $got_tail"
if { $got eq "0x56314544" && $got_tail eq "0x56314544" } {
    puts ""
    puts "Готово. Програвач має почати показ сам, щойно побачить обидва підписи."
} else {
    puts ""
    puts "Підписи не збігаються - перевірте адресу й повторіть."
}
